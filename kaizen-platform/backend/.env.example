KAIZEN_ENVIRONMENT=development
KAIZEN_DEBUG=true
KAIZEN_API_PREFIX=/api/v1
KAIZEN_DATABASE_URL=sqlite+aiosqlite:///./kaizen.db
KAIZEN_DATABASE_POOL_SIZE=5
KAIZEN_DATABASE_MAX_OVERFLOW=5
KAIZEN_JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-64-caracteres
KAIZEN_ACCESS_TOKEN_MINUTES=15
KAIZEN_REFRESH_TOKEN_DAYS=30
KAIZEN_RECOVERY_CODE_MINUTES=10
KAIZEN_COOKIE_SECURE=false
KAIZEN_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://localhost,capacitor://localhost
KAIZEN_AUTO_CREATE_TABLES=true
KAIZEN_EMAIL_DELIVERY_MODE=console
KAIZEN_SMS_DELIVERY_MODE=console
KAIZEN_SMTP_HOST=
KAIZEN_SMTP_PORT=587
KAIZEN_SMTP_USERNAME=
KAIZEN_SMTP_PASSWORD=
KAIZEN_SMTP_FROM_EMAIL=
KAIZEN_SMTP_FROM_NAME=Kaizen Life
KAIZEN_SMTP_SECURITY=starttls
KAIZEN_BREVO_API_KEY=
KAIZEN_EMAIL_FROM_EMAIL=
KAIZEN_EMAIL_FROM_NAME=Kaizen Life
KAIZEN_TWILIO_ACCOUNT_SID=
KAIZEN_TWILIO_AUTH_TOKEN=
KAIZEN_TWILIO_FROM_PHONE=
KAIZEN_GOOGLE_OAUTH_ENABLED=false
KAIZEN_GOOGLE_CLIENT_ID=
KAIZEN_GOOGLE_CLIENT_SECRET=
KAIZEN_GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback
KAIZEN_OAUTH_RETURN_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,capacitor://localhost,com.kaizenlife.app://oauth
KAIZEN_WEB_PUSH_ENABLED=false
KAIZEN_VAPID_PUBLIC_KEY=
KAIZEN_VAPID_PRIVATE_KEY=
KAIZEN_VAPID_SUBJECT=mailto:contato@seu-dominio.com
KAIZEN_FIREBASE_CREDENTIALS_PATH=
KAIZEN_FIREBASE_CREDENTIALS_JSON=
KAIZEN_NOTIFICATION_CRON_ENABLED=false
KAIZEN_CRON_SECRET=
KAIZEN_NOTIFICATION_WORKER_INTERVAL_SECONDS=30
